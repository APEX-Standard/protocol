# APEX Protocol Reference Implementation — Rust

# Build the server
build:
    cargo build

# Build in release mode
release:
    cargo build --release

# Run the server (stdio transport)
run:
    cargo run

# Run in release mode
run-release:
    cargo run --release

# Check compilation without producing binary
check:
    cargo check

# Run clippy lints
lint:
    cargo clippy -- -D warnings

# Format code
fmt:
    cargo fmt

# Check formatting without modifying
fmt-check:
    cargo fmt -- --check

# Clean build artifacts
clean:
    cargo clean
