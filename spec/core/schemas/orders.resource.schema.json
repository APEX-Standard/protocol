{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexstandard.org/spec/core/schemas/orders.resource.schema.json",
  "title": "APEX Orders Resource",
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "decimal_nonneg": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "as_of",
    "orders",
    "sequence",
    "stale_after_ms"
  ],
  "properties": {
    "account_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "instrument_id",
          "broker_symbol",
          "side",
          "order_type",
          "quantity",
          "quantity_unit",
          "time_in_force",
          "status",
          "filled_quantity",
          "remaining_quantity",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "order_id": { "type": "string", "minLength": 1 },
          "client_order_id": { "type": ["string", "null"] },
          "instrument_id": { "type": "string", "pattern": "^APEX:[A-Z]+:[A-Z0-9:.]+$" },
          "broker_symbol": { "type": "string", "minLength": 1 },
          "side": { "type": "string", "enum": ["buy", "sell"] },
          "order_type": { "type": "string", "enum": ["market", "limit", "stop", "stop_limit"] },
          "quantity": { "$ref": "#/$defs/decimal_nonneg" },
          "quantity_unit": { "type": "string", "enum": ["base_units", "shares", "contracts"] },
          "limit_price": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
          "stop_price": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
          "time_in_force": { "type": "string", "enum": ["GTC", "IOC", "FOK", "DAY"] },
          "status": { "type": "string", "enum": ["accepted", "working", "partially_filled", "filled", "cancelled", "rejected", "expired"] },
          "filled_quantity": { "$ref": "#/$defs/decimal_nonneg" },
          "remaining_quantity": { "$ref": "#/$defs/decimal_nonneg" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    },
    "sequence": { "type": "integer", "minimum": 0 },
    "stale_after_ms": { "type": "integer", "minimum": 1 }
  }
}
