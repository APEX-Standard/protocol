{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexstandard.org/spec/core/schemas/quote.resource.schema.json",
  "title": "APEX Quote Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instrument_id",
    "broker_symbol",
    "bid",
    "ask",
    "mid",
    "spread",
    "timestamp",
    "is_tradeable",
    "market_status",
    "sequence",
    "stale_after_ms"
  ],
  "properties": {
    "instrument_id": {
      "type": "string",
      "pattern": "^APEX:[A-Z]+:[A-Z0-9:.]+$"
    },
    "broker_symbol": {
      "type": "string",
      "minLength": 1
    },
    "bid": {
      "type": "number"
    },
    "ask": {
      "type": "number"
    },
    "mid": {
      "type": "number"
    },
    "spread": {
      "type": "number",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_tradeable": {
      "type": "boolean"
    },
    "market_status": {
      "type": "string",
      "enum": ["open", "closed", "pre_market", "post_market"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "stale_after_ms": {
      "type": "integer",
      "minimum": 1
    }
  }
}
