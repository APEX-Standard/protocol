{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexstandard.org/spec/core/schemas/account-summary.resource.schema.json",
  "title": "APEX Account Summary Resource",
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "decimal_nonneg": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "account_base_currency",
    "response_currency",
    "balance",
    "equity",
    "used_margin",
    "free_margin",
    "margin_level_pct",
    "unrealised_pnl",
    "realised_pnl_today",
    "as_of",
    "sequence",
    "stale_after_ms"
  ],
  "properties": {
    "account_id": { "type": "string", "minLength": 1 },
    "account_base_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "response_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "balance": { "$ref": "#/$defs/decimal" },
    "equity": { "$ref": "#/$defs/decimal" },
    "used_margin": { "$ref": "#/$defs/decimal_nonneg" },
    "free_margin": { "$ref": "#/$defs/decimal" },
    "margin_level_pct": { "$ref": "#/$defs/decimal_nonneg" },
    "unrealised_pnl": { "$ref": "#/$defs/decimal" },
    "realised_pnl_today": { "$ref": "#/$defs/decimal" },
    "as_of": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "stale_after_ms": { "type": "integer", "minimum": 1 }
  }
}
